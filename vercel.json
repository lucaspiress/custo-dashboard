{
  "installCommand": "uv pip install --python 3.12 -r requirements.txt",
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "excludeFiles": "{frontend/**,backend/tests/**,backend/data/**,backend/smoke_ui.py,backend/pytest.ini,backend/requirements-dev.txt}"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}
