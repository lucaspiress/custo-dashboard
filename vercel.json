{
  "installCommand": "if [ -n \"$VIRTUAL_ENV\" ]; then uv pip install -r requirements.txt; else uv venv --python 3.12 /tmp/uvbuild && uv pip install --python /tmp/uvbuild -r requirements.txt; fi",
  "functions": {
    "api/index.py": {
      "maxDuration": 120,
      "excludeFiles": "{frontend/**,backend/tests/**,backend/data/**,backend/smoke_ui.py,backend/pytest.ini,backend/requirements-dev.txt}"
    }
  },
  "rewrites": [
    {
      "source": "/p/:token",
      "destination": "/api/index"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/relatorios",
      "schedule": "0 8 * * *"
    }
  ]
}
